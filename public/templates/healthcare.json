{
  "id": "tpl-healthcare-hipaa",
  "name": "HIPAA Compliant Health Records API",
  "version": "1.0.0",
  "stack": {
    "language": "java-spring",
    "framework": "spring-boot",
    "database": "postgresql",
    "orm": "hibernate"
  },
  "features": [
    "Field-level AES-256-GCM encryption for PHI data",
    "Immutable access audit logging",
    "Patient record management with Doctor/Nurse role partitioning",
    "Prescription verification and digital signature tokens",
    "Strict TLS 1.3 enforcement and IP CIDR restriction support"
  ],
  "endpoints": [
    { "method": "POST", "path": "/api/v1/patients", "auth": true },
    { "method": "GET", "path": "/api/v1/patients/:id", "auth": true },
    { "method": "POST", "path": "/api/v1/patients/:id/records", "auth": true },
    { "method": "GET", "path": "/api/v1/prescriptions", "auth": true },
    { "method": "POST", "path": "/api/v1/prescriptions", "auth": true },
    { "method": "GET", "path": "/api/v1/audit/phi-access", "auth": true }
  ]
}
